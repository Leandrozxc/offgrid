@page "/shop"
@inject ProductCatalog Catalog

<PageTitle>Shop | OFFGRID</PageTitle>

<section class="min-h-screen bg-cream">
    @* Page Banner *@
    <div class="border-b border-ink/15">
        <div class="mx-auto max-w-[1500px] px-6 pb-10 pt-16 lg:px-12 lg:pt-20">
            <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
                <div>
                    <p class="label text-ink/50">Drop 04 // Fall 2026</p>
                    <h1 class="mt-2 text-5xl font-black uppercase tracking-tight sm:text-7xl">Shop</h1>
                    <p class="mt-4 max-w-xl text-sm leading-relaxed text-ink/70">
                        Oversized silhouettes, drop shoulders, and dense heavyweight textiles designed outside the trend cycle.
                    </p>
                </div>
                <div class="hidden border-l border-ink/20 pl-6 text-right font-mono text-[11px] uppercase tracking-widest text-ink/50 md:block">
                    <span>CATALOG VERSION 4.0</span><br />
                    <span>MANILA STUDIO // 14.59° N</span>
                </div>
            </div>
        </div>
    </div>

    @* Controls Bar (Sticky) *@
    <div class="sticky top-0 z-20 border-b border-ink/15 bg-cream/95 backdrop-blur-md">
        <div class="mx-auto flex max-w-[1500px] flex-wrap items-center justify-between gap-4 px-6 py-3.5 lg:px-12">
            
            @* Left: Results count & Live Search Field *@
            <div class="flex flex-1 items-center gap-4">
                <p class="text-xs font-bold uppercase tracking-wider" aria-live="polite">
                    <span class="font-black text-ink">@results.Count</span> @(results.Count == 1 ? "Item" : "Items")
                </p>

                <div class="relative max-w-xs flex-1 hidden sm:block">
                    <input type="text"
                           @bind="search"
                           @bind:event="oninput"
                           placeholder="SEARCH SILHOUETTE..."
                           class="w-full border-b border-ink/30 bg-transparent py-1 pr-6 text-xs font-semibold uppercase tracking-wider placeholder:text-ink/40 focus:border-ink focus:outline-none" />
                    @if (!string.IsNullOrWhiteSpace(search))
                    {
                        <button type="button"
                                @onclick="() => search = null"
                                class="absolute right-0 top-1 text-xs font-bold text-ink/50 hover:text-ink"
                                aria-label="Clear search">×</button>
                    }
                </div>
            </div>

            @* Right: Grid density, Mobile Filter Toggle, Sort *@
            <div class="flex items-center gap-3">
                @* Mobile Filter Drawer Trigger *@
                <button type="button"
                        class="btn btn-outline !px-4 !py-2 lg:hidden"
                        @onclick="() => drawerOpen = true">
                    Filters @(ActiveFilterCount > 0 ? $"({ActiveFilterCount})" : "")
                </button>

                @* Desktop Grid Density Switcher (2-col editorial vs 4-col compact) *@
                <div class="hidden items-center border border-ink/20 lg:flex" role="group" aria-label="Grid density">
                    <button type="button"
                            class="px-2.5 py-1.5 text-xs font-bold transition-colors @DensityClass(gridColumns == 2)"
                            title="2 Columns Editorial"
                            @onclick="() => gridColumns = 2">
                        ||
                    </button>
                    <button type="button"
                            class="border-l border-ink/20 px-2.5 py-1.5 text-xs font-bold transition-colors @DensityClass(gridColumns == 4)"
                            title="4 Columns Compact"
                            @onclick="() => gridColumns = 4">
                        ||||
                    </button>
                </div>

                @* Sort Dropdown *@
                <div class="flex items-center gap-2">
                    <label for="sort" class="label hidden text-ink/60 sm:block">Sort</label>
                    <select id="sort" @bind="sort" class="field !w-auto !py-1.5 text-xs font-bold uppercase tracking-wider">
                        <option value="featured">Featured</option>
                        <option value="new">Newest Drop</option>
                        <option value="price-asc">Price: Low → High</option>
                        <option value="price-desc">Price: High → Low</option>
                    </select>
                </div>
            </div>
        </div>

        @* Active Filter Badges Bar *@
        @if (HasFilters)
        {
            <div class="mx-auto flex max-w-[1500px] flex-wrap items-center gap-2 px-6 pb-3 pt-1 lg:px-12">
                <span class="text-[10px] font-bold uppercase tracking-widest text-ink/40">Active:</span>
                @if (category is not null)
                {
                    <button type="button" class="inline-flex items-center gap-1.5 border border-ink bg-ink px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-80"
                            @onclick="() => category = null">
                        <span>Category: @category</span>
                        <span>×</span>
                    </button>
                }
                @if (size is not null)
                {
                    <button type="button" class="inline-flex items-center gap-1.5 border border-ink bg-ink px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-80"
                            @onclick="() => size = null">
                        <span>Size: @size</span>
                        <span>×</span>
                    </button>
                }
                @if (color is not null)
                {
                    <button type="button" class="inline-flex items-center gap-1.5 border border-ink bg-ink px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-80"
                            @onclick="() => color = null">
                        <span>Color: @color</span>
                        <span>×</span>
                    </button>
                }
                @if (inStockOnly)
                {
                    <button type="button" class="inline-flex items-center gap-1.5 border border-ink bg-ink px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-80"
                            @onclick="() => inStockOnly = false">
                        <span>In Stock Only</span>
                        <span>×</span>
                    </button>
                }
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <button type="button" class="inline-flex items-center gap-1.5 border border-ink bg-ink px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-80"
                            @onclick="() => search = null">
                        <span>Search: @search</span>
                        <span>×</span>
                    </button>
                }
                <button type="button"
                        class="ml-2 text-[10px] font-bold uppercase tracking-widest text-ink underline underline-offset-4 hover:opacity-60"
                        @onclick="ClearFilters">
                    Clear All
                </button>
            </div>
        }
    </div>

    @* Main Shop Grid & Sidebar *@
    <div class="mx-auto max-w-[1500px] px-6 py-12 lg:px-12">
        <div class="grid gap-12 lg:grid-cols-[16rem_1fr]">
            
            @* Desktop Sidebar Filters *@
            <aside class="hidden space-y-8 lg:sticky lg:top-28 lg:block lg:self-start" aria-label="Shop Filters">
                @* Categories *@
                <div>
                    <h2 class="label border-b border-ink/15 pb-2 text-ink">Categories</h2>
                    <div class="mt-3 flex flex-col gap-1">
                        <button type="button"
                                class="flex items-center justify-between py-1.5 text-xs font-semibold uppercase tracking-wider transition-colors hover:text-ink @CategoryClass(category is null)"
                                @onclick="() => category = null">
                            <span>All Collections</span>
                            <span class="text-ink/40">@Catalog.All.Count</span>
                        </button>
                        @foreach (var c in ProductCatalog.Categories)
                        {
                            var count = Catalog.All.Count(p => p.Category == c);
                            <button type="button"
                                    class="flex items-center justify-between py-1.5 text-xs font-semibold uppercase tracking-wider transition-colors hover:text-ink @CategoryClass(category == c)"
                                    @onclick="() => category = c">
                                <span>@c</span>
                                <span class="text-ink/40">@count</span>
                            </button>
                        }
                    </div>
                </div>

                @* Sizes *@
                <div>
                    <h2 class="label border-b border-ink/15 pb-2 text-ink">Sizes</h2>
                    <div class="mt-3 grid grid-cols-4 gap-1.5">
                        @foreach (var s in ProductCatalog.SizeOrder)
                        {
                            var active = size == s;
                            var count = Catalog.All.Count(p => p.Sizes.Contains(s));
                            <button type="button"
                                    class="flex flex-col items-center border py-2 text-xs font-bold uppercase tracking-wider transition-all @SizeClass(active)"
                                    aria-pressed="@(active ? "true" : "false")"
                                    @onclick="() => size = size == s ? null : s">
                                <span>@s</span>
                                <span class="text-[9px] font-normal opacity-60">@count</span>
                            </button>
                        }
                    </div>
                </div>

                @* Colors *@
                <div>
                    <h2 class="label border-b border-ink/15 pb-2 text-ink">Colors</h2>
                    <div class="mt-3 flex flex-col gap-1.5">
                        @foreach (var c in Catalog.AllColors())
                        {
                            var active = string.Equals(color, c.Name, StringComparison.OrdinalIgnoreCase);
                            var count = Catalog.All.Count(p => p.Colors.Any(col => string.Equals(col.Name, c.Name, StringComparison.OrdinalIgnoreCase)));
                            <button type="button"
                                    class="flex items-center justify-between border px-3 py-2 text-xs font-semibold uppercase tracking-wider transition-all @ColorRowClass(active)"
                                    aria-pressed="@(active ? "true" : "false")"
                                    @onclick="() => color = active ? null : c.Name">
                                <div class="flex items-center gap-2.5">
                                    <span class="h-3.5 w-3.5 shrink-0 rounded-full border border-ink/30" style="background-color:@c.Hex"></span>
                                    <span>@c.Name</span>
                                </div>
                                <span class="text-[10px] opacity-60">@count</span>
                            </button>
                        }
                    </div>
                </div>

                @* Availability Toggle *@
                <div class="border-t border-ink/15 pt-6">
                    <label class="flex cursor-pointer items-center justify-between text-xs font-semibold uppercase tracking-wider">
                        <span>In Stock Only</span>
                        <input type="checkbox"
                               checked="@inStockOnly"
                               @onchange="(e) => inStockOnly = (bool)(e.Value ?? false)"
                               class="h-4 w-4 rounded-none border border-ink text-ink accent-ink focus:ring-0" />
                    </label>
                </div>
            </aside>

            @* Products Grid *@
            <div>
                @if (results.Count == 0)
                {
                    <div class="flex min-h-[50vh] flex-col items-center justify-center border border-dashed border-ink/30 p-12 text-center">
                        <span class="font-mono text-xs uppercase tracking-widest text-ink/40">QUERY RETURNED 0 SILHOUETTES</span>
                        <h2 class="mt-3 text-3xl font-black uppercase tracking-tight">No match found.</h2>
                        <p class="mt-2 text-sm text-ink/60">Try removing an active color or size filter.</p>
                        <button type="button" class="btn btn-dark mt-6" @onclick="ClearFilters">Clear All Filters</button>
                    </div>
                }
                else
                {
                    <div @key="GridKey" class="animate-fade @GridClass">
                        @foreach (var p in results)
                        {
                            <ProductCard Product="p" ColorName="@color" @key="p.Id" />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@* Slide-over Mobile Filters Drawer *@
@if (drawerOpen)
{
    <div class="fixed inset-0 z-50 flex lg:hidden" role="dialog" aria-modal="true" aria-label="Filters Drawer">
        <div class="fixed inset-0 bg-ink/60 backdrop-blur-sm transition-opacity" @onclick="() => drawerOpen = false"></div>

        <div class="relative ml-auto flex h-full w-full max-w-xs flex-col bg-cream shadow-2xl">
            <div class="flex items-center justify-between border-b border-ink/15 p-5">
                <span class="label text-ink">Filters</span>
                <button type="button" class="text-lg font-black hover:opacity-60" @onclick="() => drawerOpen = false">×</button>
            </div>

            <div class="flex-1 space-y-8 overflow-y-auto p-5">
                @* Mobile Search *@
                <div>
                    <label class="label block text-ink">Search</label>
                    <input type="text"
                           @bind="search"
                           @bind:event="oninput"
                           placeholder="KEYWORDS..."
                           class="field mt-2 bg-white" />
                </div>

                @* Mobile Categories *@
                <div>
                    <label class="label block text-ink">Category</label>
                    <div class="mt-2 flex flex-col gap-1">
                        <button type="button" class="text-left py-1 text-xs font-bold uppercase tracking-wider @CategoryClass(category is null)"
                                @onclick="() => category = null">All Collections</button>
                        @foreach (var c in ProductCatalog.Categories)
                        {
                            <button type="button" class="text-left py-1 text-xs font-bold uppercase tracking-wider @CategoryClass(category == c)"
                                    @onclick="() => category = c">@c</button>
                        }
                    </div>
                </div>

                @* Mobile Sizes *@
                <div>
                    <label class="label block text-ink">Size</label>
                    <div class="mt-2 grid grid-cols-4 gap-1.5">
                        @foreach (var s in ProductCatalog.SizeOrder)
                        {
                            var active = size == s;
                            <button type="button" class="border py-2 text-xs font-bold uppercase @SizeClass(active)"
                                    @onclick="() => size = size == s ? null : s">@s</button>
                        }
                    </div>
                </div>

                @* Mobile Colors *@
                <div>
                    <label class="label block text-ink">Color</label>
                    <div class="mt-2 flex flex-wrap gap-2">
                        @foreach (var c in Catalog.AllColors())
                        {
                            var active = string.Equals(color, c.Name, StringComparison.OrdinalIgnoreCase);
                            <button type="button" class="inline-flex items-center gap-1.5 border px-2.5 py-1.5 text-xs font-bold uppercase @ColorRowClass(active)"
                                    @onclick="() => color = active ? null : c.Name">
                                <span class="h-3 w-3 rounded-full border border-ink/30" style="background-color:@c.Hex"></span>
                                <span>@c.Name</span>
                            </button>
                        }
                    </div>
                </div>

                @* Mobile In-Stock *@
                <div class="border-t border-ink/15 pt-4">
                    <label class="flex items-center justify-between text-xs font-bold uppercase tracking-wider">
                        <span>In Stock Only</span>
                        <input type="checkbox"
                               checked="@inStockOnly"
                               @onchange="(e) => inStockOnly = (bool)(e.Value ?? false)"
                               class="h-4 w-4 accent-ink" />
                    </label>
                </div>
            </div>

            <div class="border-t border-ink/15 p-5">
                <button type="button" class="btn btn-dark w-full" @onclick="() => drawerOpen = false">
                    View Results (@results.Count)
                </button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "category")] public string? CategoryQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }

    string? category, size, color, search, appliedKey;
    string sort = "featured";
    bool drawerOpen;
    bool inStockOnly;
    int gridColumns = 4;

    bool HasFilters => category is not null || size is not null || color is not null || inStockOnly || !string.IsNullOrWhiteSpace(search);
    int ActiveFilterCount => (category is not null ? 1 : 0) + (size is not null ? 1 : 0) + (color is not null ? 1 : 0) + (inStockOnly ? 1 : 0) + (!string.IsNullOrWhiteSpace(search) ? 1 : 0);
    string GridKey => $"{category}|{size}|{color}|{sort}|{search}|{inStockOnly}|{gridColumns}";

    string GridClass => gridColumns == 2
        ? "grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-14"
        : "grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-12 sm:gap-x-6";

    List<Product> results => Filtered().ToList();

    static string CategoryClass(bool on) => on ? "text-ink font-bold underline underline-offset-4" : "text-ink/60";
    static string SizeClass(bool on) => on ? "border-ink bg-ink text-white" : "border-ink/20 hover:border-ink";
    static string ColorRowClass(bool on) => on ? "border-ink bg-ink text-white ring-1 ring-ink ring-offset-1" : "border-ink/20 hover:border-ink";
    static string DensityClass(bool on) => on ? "bg-ink text-white" : "bg-transparent text-ink/40 hover:text-ink";

    protected override void OnParametersSet()
    {
        var key = $"{CategoryQuery}|{SortQuery}|{SearchQuery}";
        if (key == appliedKey) return;
        appliedKey = key;

        category = CategoryQuery is not null && ProductCatalog.Categories.Contains(CategoryQuery) ? CategoryQuery : null;
        sort = SortQuery is "new" or "price-asc" or "price-desc" ? SortQuery : "featured";
        search = string.IsNullOrWhiteSpace(SearchQuery) ? null : SearchQuery.Trim();
        size = null;
        color = null;
        inStockOnly = false;
    }

    void ClearFilters()
    {
        category = null;
        size = null;
        color = null;
        search = null;
        inStockOnly = false;
    }

    IEnumerable<Product> Filtered()
    {
        var q = Catalog.All.AsEnumerable();
        if (category is not null) q = q.Where(p => p.Category == category);
        if (size is not null) q = q.Where(p => p.Sizes.Contains(size));
        if (color is not null) q = q.Where(p => p.Colors.Any(c => string.Equals(c.Name, color, StringComparison.OrdinalIgnoreCase)));
        if (inStockOnly) q = q.Where(p => p.Stock > 0);
        if (!string.IsNullOrWhiteSpace(search))
            q = q.Where(p => p.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                          || p.Category.Contains(search, StringComparison.OrdinalIgnoreCase));

        return sort switch
        {
            "new" => q.OrderByDescending(p => p.Released),
            "price-asc" => q.OrderBy(p => p.Price),
            "price-desc" => q.OrderByDescending(p => p.Price),
            _ => q
        };
    }
}