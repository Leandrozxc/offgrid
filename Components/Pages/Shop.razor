@page "/shop"
@inject ProductCatalog Catalog

<PageTitle>Shop | OFFGRID</PageTitle>

<section class="bg-cream">
    <div class="mx-auto max-w-[1400px] px-5 pb-8 pt-14 lg:px-10 lg:pt-20">
        <p class="label animate-rise text-ink/60">The Collection</p>
        <h1 class="animate-rise mt-3 text-5xl font-black uppercase tracking-tight delay-1 sm:text-7xl">Shop</h1>
        <p class="animate-rise mt-4 max-w-xl text-base text-ink/70 delay-2">
            Oversized fits, expressive graphics, and everyday essentials for the ones who move differently.
        </p>
    </div>

    <div class="mx-auto max-w-[1400px] px-5 pb-24 lg:px-10">
        <div class="flex flex-wrap items-center justify-between gap-4 border-y border-ink/15 py-4">
            <p class="text-sm" aria-live="polite">
                <span class="font-semibold">@results.Count</span> @(results.Count == 1 ? "product" : "products")
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <button type="button" class="ml-3 border border-ink/30 px-2.5 py-1 text-xs uppercase tracking-wider hover:border-ink"
                            @onclick="() => search = null" aria-label="Clear search @search">Search: @search ×</button>
                }
            </p>
            <div class="flex items-center gap-3">
                <button type="button" class="btn btn-outline !py-2.5 lg:hidden" @onclick="() => filtersOpen = !filtersOpen"
                        aria-expanded="@(filtersOpen ? "true" : "false")">Filters</button>
                <label for="sort" class="sr-only">Sort by</label>
                <select id="sort" @bind="sort" class="field !w-auto !py-2.5">
                    <option value="featured">Featured</option>
                    <option value="new">Newest</option>
                    <option value="price-asc">Price: low to high</option>
                    <option value="price-desc">Price: high to low</option>
                </select>
            </div>
        </div>

        <div class="mt-10 grid gap-10 lg:grid-cols-[14rem_1fr]">
            <aside class="@(filtersOpen ? "block" : "hidden") space-y-8 lg:block" aria-label="Filters">
                <div>
                    <h2 class="label">Category</h2>
                    <div class="mt-3 flex flex-wrap gap-2">
                        <button type="button" class="@ChipBase @Chip(category is null)" aria-pressed="@Pressed(category is null)" @onclick="() => category = null">All</button>
                        @foreach (var c in ProductCatalog.Categories)
                        {
                            <button type="button" class="@ChipBase @Chip(category == c)" aria-pressed="@Pressed(category == c)" @onclick="() => category = c">@c</button>
                        }
                    </div>
                </div>
                <div>
                    <h2 class="label">Size</h2>
                    <div class="mt-3 flex flex-wrap gap-2">
                        @foreach (var s in ProductCatalog.SizeOrder)
                        {
                            <button type="button" class="@ChipBase @Chip(size == s)" aria-pressed="@Pressed(size == s)" @onclick="() => size = size == s ? null : s">@s</button>
                        }
                    </div>
                </div>
                <div>
                    <h2 class="label">Color</h2>
                    <div class="mt-3 flex flex-wrap gap-2">
                        @foreach (var c in Catalog.AllColors())
                        {
                            <button type="button" class="@ChipBase flex items-center gap-2 @Chip(color == c.Name)" aria-pressed="@Pressed(color == c.Name)"
                                    @onclick="() => color = color == c.Name ? null : c.Name">
                                <span class="h-3 w-3 rounded-full border border-ink/30" style="background-color:@c.Hex"></span>@c.Name
                            </button>
                        }
                    </div>
                </div>
                <button type="button" class="text-xs font-semibold uppercase tracking-[0.18em] underline underline-offset-4 disabled:opacity-40"
                        disabled="@(!HasFilters)" @onclick="ClearFilters">Clear filters</button>
            </aside>

            <div>
                @if (results.Count == 0)
                {
                    <div class="flex min-h-[40vh] flex-col items-start justify-center">
                        <h2 class="text-3xl font-black uppercase tracking-tight">No pieces match.</h2>
                        <p class="mt-3 text-ink/70">Try removing a filter or two.</p>
                        <button type="button" class="btn btn-dark mt-6" @onclick="ClearFilters">Clear filters</button>
                    </div>
                }
                else
                {
                    <div @key="GridKey" class="animate-fade grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 lg:gap-x-6">
                        @foreach (var p in results)
                        {
                            <ProductCard Product="p" ColorName="@color" @key="p.Id" />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "category")] public string? CategoryQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }

    const string ChipBase = "border px-3.5 py-2 text-xs font-semibold uppercase tracking-[0.14em] transition-colors";

    string? category, size, color, search, appliedKey;
    string sort = "featured";
    bool filtersOpen;

    static string Chip(bool on) => on ? "border-ink bg-ink text-white" : "border-ink/30 hover:border-ink";
    static string Pressed(bool on) => on ? "true" : "false";

    bool HasFilters => category is not null || size is not null || color is not null || !string.IsNullOrWhiteSpace(search);
    string GridKey => $"{category}|{size}|{color}|{sort}|{search}";

    List<Product> results => Filtered().ToList();

    protected override void OnParametersSet()
    {
        var key = $"{CategoryQuery}|{SortQuery}|{SearchQuery}";
        if (key == appliedKey) return;
        appliedKey = key;

        category = CategoryQuery is not null && ProductCatalog.Categories.Contains(CategoryQuery) ? CategoryQuery : null;
        sort = SortQuery is "new" or "price-asc" or "price-desc" ? SortQuery : "featured";
        search = string.IsNullOrWhiteSpace(SearchQuery) ? null : SearchQuery.Trim();
        size = null;
        color = null;
    }

    void ClearFilters() { category = size = color = search = null; }

    IEnumerable<Product> Filtered()
    {
        var q = Catalog.All.AsEnumerable();
        if (category is not null) q = q.Where(p => p.Category == category);
        if (size is not null) q = q.Where(p => p.Sizes.Contains(size));
        if (color is not null) q = q.Where(p => p.Colors.Any(c => c.Name == color));
        if (!string.IsNullOrWhiteSpace(search))
            q = q.Where(p => p.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                          || p.Category.Contains(search, StringComparison.OrdinalIgnoreCase));

        return sort switch
        {
            "new" => q.OrderByDescending(p => p.Released),
            "price-asc" => q.OrderBy(p => p.Price),
            "price-desc" => q.OrderByDescending(p => p.Price),
            _ => q
        };
    }
}