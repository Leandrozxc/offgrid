@page "/shop"
@inject ProductCatalog Catalog

<PageTitle>All Collections | OFFGRID</PageTitle>

<section class="min-h-screen bg-white text-ink">
    @* UNIQLO Horizontal Category Tabs *@
    <div class="border-b border-ink/15">
        <div class="mx-auto flex max-w-[1500px] overflow-x-auto px-4 sm:px-8">
            <button type="button"
                    class="shrink-0 border-b-2 px-4 py-3.5 text-xs font-bold uppercase tracking-wider transition-colors @TabClass(category is null)"
                    @onclick="() => category = null">
                All Items
            </button>
            @foreach (var c in ProductCatalog.Categories)
            {
                var isCurrent = category == c;
                <button type="button"
                        class="shrink-0 border-b-2 px-4 py-3.5 text-xs font-bold uppercase tracking-wider transition-colors @TabClass(isCurrent)"
                        @onclick="() => category = c">
                    @c
                </button>
            }
        </div>
    </div>

    @* Store Stock Sub-bar *@
    <div class="border-b border-ink/10 bg-fog/30">
        <div class="mx-auto flex max-w-[1500px] items-center justify-between px-4 py-2.5 text-xs sm:px-8">
            <div class="flex items-center gap-2 text-ink/80">
                <svg class="h-4 w-4 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
                <span class="font-medium">Select a studio to search local store stock</span>
            </div>
            <button type="button" class="font-semibold text-ink underline underline-offset-2 hover:opacity-70">
                Select store
            </button>
        </div>
    </div>

    @* Results & Controls Bar *@
    <div class="border-b border-ink/10 bg-white">
        <div class="mx-auto flex max-w-[1500px] items-center justify-between px-4 py-3 sm:px-8">
            <div class="text-xs font-bold uppercase tracking-wider text-ink/80" aria-live="polite">
                Results: <span class="font-extrabold text-ink">@results.Count</span> items
            </div>

            <div class="flex items-center gap-4">
                @* Sort by Dropdown *@
                <div class="flex items-center gap-1.5 text-xs font-semibold">
                    <svg class="h-3.5 w-3.5 stroke-current stroke-2 fill-none" viewBox="0 0 24 24"><path d="M7 16V4m0 0L3 8m4-4l4 4m6 4v12m0 0l4-4m-4 4l-4-4"/></svg>
                    <label for="sort" class="hidden sm:inline">Sort by</label>
                    <select id="sort" @bind="sort" class="border-none bg-transparent py-1 pr-6 text-xs font-bold uppercase focus:ring-0">
                        <option value="featured">Featured</option>
                        <option value="new">New Arrival</option>
                        <option value="price-asc">Price: Low to High</option>
                        <option value="price-desc">Price: High to Low</option>
                    </select>
                </div>

                @* Filter Trigger *@
                <button type="button"
                        class="flex items-center gap-1.5 text-xs font-semibold hover:opacity-70"
                        @onclick="() => drawerOpen = true">
                    <svg class="h-3.5 w-3.5 stroke-current stroke-2 fill-none" viewBox="0 0 24 24"><path d="M4 21v-7m0-4V3m8 18v-9m0-4V3m8 18v-5m0-4V3M1 14h6m2-6h6m2 8h6"/></svg>
                    <span>Filter @(ActiveFilterCount > 0 ? $"({ActiveFilterCount})" : "")</span>
                </button>
            </div>
        </div>

        @* Active Filter Tag Chips *@
        @if (HasFilters)
        {
            <div class="mx-auto flex max-w-[1500px] flex-wrap items-center gap-2 border-t border-ink/10 px-4 py-2 sm:px-8">
                @if (category is not null)
                {
                    <button type="button" class="inline-flex items-center gap-1 rounded bg-fog px-2.5 py-1 text-[11px] font-semibold text-ink"
                            @onclick="() => category = null">
                        <span>@category</span>
                        <span class="text-xs">×</span>
                    </button>
                }
                @if (size is not null)
                {
                    <button type="button" class="inline-flex items-center gap-1 rounded bg-fog px-2.5 py-1 text-[11px] font-semibold text-ink"
                            @onclick="() => size = null">
                        <span>Size: @size</span>
                        <span class="text-xs">×</span>
                    </button>
                }
                @if (color is not null)
                {
                    <button type="button" class="inline-flex items-center gap-1 rounded bg-fog px-2.5 py-1 text-[11px] font-semibold text-ink"
                            @onclick="() => color = null">
                        <span>Color: @color</span>
                        <span class="text-xs">×</span>
                    </button>
                }
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <button type="button" class="inline-flex items-center gap-1 rounded bg-fog px-2.5 py-1 text-[11px] font-semibold text-ink"
                            @onclick="() => search = null">
                        <span>Keyword: @search</span>
                        <span class="text-xs">×</span>
                    </button>
                }
                <button type="button"
                        class="text-[11px] font-semibold text-ink underline underline-offset-2 hover:opacity-60"
                        @onclick="ClearFilters">
                    Clear all
                </button>
            </div>
        }
    </div>

    @* UNIQLO Product Grid (2 cols mobile, 4 cols desktop with tight gutters) *@
    <div class="mx-auto max-w-[1500px] px-4 py-6 sm:px-8">
        @if (results.Count == 0)
        {
            <div class="flex min-h-[40vh] flex-col items-center justify-center py-16 text-center">
                <p class="text-base font-bold uppercase tracking-wider text-ink">No items match your selection.</p>
                <p class="mt-1 text-xs text-ink/60">Try clearing one or more filters.</p>
                <button type="button" class="btn btn-dark mt-6" @onclick="ClearFilters">Clear all filters</button>
            </div>
        }
        else
        {
            <div @key="GridKey" class="grid grid-cols-2 gap-x-3 gap-y-8 sm:gap-x-4 md:grid-cols-3 lg:grid-cols-4">
                @foreach (var p in results)
                {
                    <ProductCard Product="p" ColorName="@color" @key="p.Id" />
                }
            </div>
        }
    </div>
</section>

@* UNIQLO Filter Slide-Over Modal *@
@if (drawerOpen)
{
    <div class="fixed inset-0 z-50 flex justify-end" role="dialog" aria-modal="true" aria-label="Filters">
        <div class="fixed inset-0 bg-ink/50 transition-opacity" @onclick="() => drawerOpen = false"></div>

        <div class="relative flex h-full w-full max-w-sm flex-col bg-white shadow-xl">
            <div class="flex items-center justify-between border-b border-ink/15 px-6 py-4">
                <span class="text-sm font-black uppercase tracking-wider">Filter Items</span>
                <button type="button" class="p-1 text-xl font-bold hover:opacity-60" @onclick="() => drawerOpen = false">×</button>
            </div>

            <div class="flex-1 space-y-6 overflow-y-auto px-6 py-5">
                @* Size Filter *@
                <div>
                    <h3 class="text-xs font-bold uppercase tracking-wider text-ink">Size</h3>
                    <div class="mt-3 grid grid-cols-4 gap-2">
                        @foreach (var s in ProductCatalog.SizeOrder)
                        {
                            var active = size == s;
                            <button type="button"
                                    class="border py-2 text-xs font-bold uppercase transition-all @FilterPillClass(active)"
                                    @onclick="() => size = size == s ? null : s">
                                @s
                            </button>
                        }
                    </div>
                </div>

                @* Color Filter *@
                <div>
                    <h3 class="text-xs font-bold uppercase tracking-wider text-ink">Color</h3>
                    <div class="mt-3 flex flex-wrap gap-2">
                        @foreach (var c in Catalog.AllColors())
                        {
                            var active = string.Equals(color, c.Name, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    class="inline-flex items-center gap-2 border px-3 py-1.5 text-xs font-semibold @FilterPillClass(active)"
                                    @onclick="() => color = active ? null : c.Name">
                                <span class="h-3 w-3 rounded-full border border-ink/30" style="background-color:@c.Hex"></span>
                                <span>@c.Name</span>
                            </button>
                        }
                    </div>
                </div>

                @* Search Keyword *@
                <div>
                    <h3 class="text-xs font-bold uppercase tracking-wider text-ink">Keyword</h3>
                    <input type="text"
                           @bind="search"
                           @bind:event="oninput"
                           placeholder="Search product..."
                           class="field mt-2 bg-fog/20" />
                </div>
            </div>

            <div class="flex items-center gap-3 border-t border-ink/15 p-4">
                <button type="button" class="btn btn-outline flex-1" @onclick="ClearFilters">Reset</button>
                <button type="button" class="btn btn-dark flex-1" @onclick="() => drawerOpen = false">Show Results (@results.Count)</button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "category")] public string? CategoryQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }

    string? category, size, color, search, appliedKey;
    string sort = "featured";
    bool drawerOpen;

    bool HasFilters => category is not null || size is not null || color is not null || !string.IsNullOrWhiteSpace(search);
    int ActiveFilterCount => (category is not null ? 1 : 0) + (size is not null ? 1 : 0) + (color is not null ? 1 : 0) + (!string.IsNullOrWhiteSpace(search) ? 1 : 0);
    string GridKey => $"{category}|{size}|{color}|{sort}|{search}";

    List<Product> results => Filtered().ToList();

    static string TabClass(bool active) => active
        ? "border-ink text-ink"
        : "border-transparent text-ink/50 hover:text-ink";

    static string FilterPillClass(bool active) => active
        ? "border-ink bg-ink text-white"
        : "border-ink/20 bg-white text-ink hover:border-ink";

    protected override void OnParametersSet()
    {
        var key = $"{CategoryQuery}|{SortQuery}|{SearchQuery}";
        if (key == appliedKey) return;
        appliedKey = key;

        category = CategoryQuery is not null && ProductCatalog.Categories.Contains(CategoryQuery) ? CategoryQuery : null;
        sort = SortQuery is "new" or "price-asc" or "price-desc" ? SortQuery : "featured";
        search = string.IsNullOrWhiteSpace(SearchQuery) ? null : SearchQuery.Trim();
        size = null;
        color = null;
    }

    void ClearFilters()
    {
        category = null;
        size = null;
        color = null;
        search = null;
    }

    IEnumerable<Product> Filtered()
    {
        var q = Catalog.All.AsEnumerable();
        if (category is not null) q = q.Where(p => p.Category == category);
        if (size is not null) q = q.Where(p => p.Sizes.Contains(size));
        if (color is not null) q = q.Where(p => p.Colors.Any(c => string.Equals(c.Name, color, StringComparison.OrdinalIgnoreCase)));
        if (!string.IsNullOrWhiteSpace(search))
            q = q.Where(p => p.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                          || p.Category.Contains(search, StringComparison.OrdinalIgnoreCase));

        return sort switch
        {
            "new" => q.OrderByDescending(p => p.Released),
            "price-asc" => q.OrderBy(p => p.Price),
            "price-desc" => q.OrderByDescending(p => p.Price),
            _ => q
        };
    }
}