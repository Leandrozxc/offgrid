@page "/"
@using System.ComponentModel.DataAnnotations
@inject ProductCatalog Catalog
@inject IJSRuntime JS

<PageTitle>OFFGRID | Outside the Ordinary.</PageTitle>

@* HERO (dark) *@
<section class="bg-ink text-white">
    <div class="mx-auto grid max-w-[1600px] lg:grid-cols-12">
        <div class="flex flex-col justify-end px-5 pb-14 pt-20 lg:col-span-7 lg:min-h-[85vh] lg:px-10 lg:pb-20">
            <p class="label animate-rise text-white/60">Drop 04 — Fall 2026</p>
            <h1 class="mt-6 text-[clamp(3.25rem,10vw,8.5rem)] font-black uppercase leading-[0.88] tracking-tighter">
                <span class="block animate-rise delay-1">Outside</span>
                <span class="block animate-rise delay-2">the</span>
                <span class="block animate-rise delay-3">ordinary.</span>
            </h1>
            <p class="animate-rise mt-8 max-w-md text-base text-white/70 delay-3">
                Independent streetwear built on oversized silhouettes, expressive graphics, and the freedom to skip the trend cycle.
            </p>
            <div class="animate-rise mt-10 flex flex-wrap gap-4 delay-3">
                <a href="/shop" class="btn btn-light">Shop the collection</a>
                <button type="button" class="btn btn-outline-light" @onclick='() => JS.InvokeVoidAsync("offgrid.scrollToId", "story")'>Discover OFFGRID</button>
            </div>
        </div>
        <div class="hero-media relative min-h-[360px] bg-concrete lg:col-span-5">
            @if (HeroImage is not null)
            {
                <img src="@HeroImage" alt="OFFGRID campaign: model in an oversized black tee against concrete" class="absolute inset-0 h-full w-full object-cover" />
            }
            else
            {
                <div class="absolute inset-0 flex items-end p-6" aria-hidden="true">
                    <span class="select-none text-[clamp(7rem,18vw,15rem)] font-black leading-none tracking-tighter text-ink/15">OG</span>
                </div>
            }
        </div>
    </div>
</section>

@* FEATURED (cream) *@
<section class="bg-cream">
    <div class="mx-auto max-w-[1400px] px-5 py-20 lg:px-10 lg:py-28">
        <Reveal>
            <div class="flex items-end justify-between gap-6">
                <div>
                    <p class="label text-ink/60">Featured</p>
                    <h2 class="mt-2 text-4xl font-black uppercase tracking-tight sm:text-5xl">The Collection</h2>
                </div>
                <a href="/shop" class="nav-link shrink-0">View all</a>
            </div>
            <div class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 lg:grid-cols-4 lg:gap-x-6">
                @foreach (var p in Catalog.Featured())
                {
                    <ProductCard Product="p" @key="p.Id" />
                }
            </div>
        </Reveal>
    </div>
</section>

@* CATEGORIES (white) *@
<section class="border-y border-ink/10 bg-white">
    <div class="mx-auto max-w-[1400px] px-5 py-20 lg:px-10 lg:py-28">
        <Reveal>
            <p class="label text-ink/60">Browse</p>
            <h2 class="mt-2 text-4xl font-black uppercase tracking-tight sm:text-5xl">Shop by category</h2>
            <div class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 lg:grid-cols-4 lg:gap-x-6">
                @foreach (var c in ProductCatalog.Categories)
                {
                    var rep = Catalog.All.First(p => p.Category == c);
                    <a href="@(ProductCatalog.CategoryUrl(c))" class="group block">
                        <ProductImage Product="rep" />
                        <div class="mt-3 flex items-center justify-between border-b border-ink pb-3">
                            <span class="text-base font-black uppercase tracking-tight sm:text-lg">@c</span>
                            <span class="label transition-transform duration-300 group-hover:translate-x-1">Shop</span>
                        </div>
                    </a>
                }
            </div>
        </Reveal>
    </div>
</section>

@* EDITORIAL (dark) *@
<section id="story" class="bg-ink text-white">
    <div class="mx-auto grid max-w-[1400px] items-center gap-12 px-5 py-20 lg:grid-cols-12 lg:px-10 lg:py-32">
        <Reveal Class="lg:col-span-7">
            <p class="label text-white/60">The OFFGRID idea</p>
            <p class="mt-6 text-3xl font-black uppercase leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
                Built for those who move differently.
            </p>
            <p class="mt-8 max-w-lg text-base text-white/70">
                OFFGRID exists beyond the expected, bringing together everyday essentials, expressive graphics, and silhouettes that speak for themselves.
            </p>
            <a href="/shop?sort=new" class="btn btn-outline-light mt-10">See what's new</a>
        </Reveal>
        <Reveal Class="lg:col-span-5" Delay="150">
            <div class="flex aspect-[4/5] items-end bg-concrete p-6" aria-hidden="true">
                <span class="select-none text-6xl font-black uppercase leading-[0.9] tracking-tighter text-ink/20">No<br />Signal</span>
            </div>
        </Reveal>
    </div>
</section>

@* NEW ARRIVALS (cream) *@
<section class="bg-cream">
    <div class="mx-auto max-w-[1400px] px-5 py-20 lg:px-10 lg:py-28">
        <Reveal>
            <div class="flex items-end justify-between gap-6">
                <div>
                    <p class="label text-ink/60">Just landed</p>
                    <h2 class="mt-2 text-4xl font-black uppercase tracking-tight sm:text-5xl">New arrivals</h2>
                </div>
                <a href="/shop?sort=new" class="nav-link shrink-0">Shop all new</a>
            </div>
            <div class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 lg:grid-cols-4 lg:gap-x-6">
                @foreach (var p in Catalog.NewArrivals(4))
                {
                    <ProductCard Product="p" @key="p.Id" />
                }
            </div>
        </Reveal>
    </div>
</section>

@* NEWSLETTER (light gray) *@
<section class="border-t border-ink/10 bg-fog">
    <div class="mx-auto max-w-[1400px] px-5 py-20 lg:px-10 lg:py-28">
        <Reveal Class="mx-auto max-w-xl text-center">
            <p class="label text-ink/60">Stay off the grid</p>
            <h2 class="mt-2 text-4xl font-black uppercase tracking-tight sm:text-5xl">First to know.</h2>
            <p class="mt-4 text-ink/70">Drop dates and restocks. Nothing else.</p>

            @if (subscribed)
            {
                <p role="status" class="mt-8 text-lg font-semibold">You're on the list. (Demo only, nothing was sent.)</p>
            }
            else
            {
                <EditForm Model="newsletter" OnValidSubmit="Subscribe" class="mt-8 text-left" novalidate>
                    <DataAnnotationsValidator />
                    <label for="nl-email" class="sr-only">Email address</label>
                    <div class="flex flex-col gap-3 sm:flex-row">
                        <InputText id="nl-email" @bind-Value="newsletter.Email" class="field" placeholder="Email address" autocomplete="email" />
                        <button type="submit" class="btn btn-dark shrink-0">Subscribe</button>
                    </div>
                    <ValidationMessage For="() => newsletter.Email" class="mt-2 text-sm text-red-700" />
                </EditForm>
            }
        </Reveal>
    </div>
</section>

@code {
    // Drop a real file in wwwroot/images/ and set this, e.g. "images/hero.jpg"
    const string? HeroImage = "/images/hero/hero.jpg";

    readonly NewsletterModel newsletter = new();
    bool subscribed;

    void Subscribe() => subscribed = true;

    class NewsletterModel
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [RegularExpression(@"^[^@\s]+@[^@\s]+\.[^@\s]+$", ErrorMessage = "Enter a valid email address.")]
        public string? Email { get; set; }
    }
}