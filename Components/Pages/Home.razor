@page "/"
@using System.ComponentModel.DataAnnotations
@inject ProductCatalog Catalog
@inject IJSRuntime JS

<PageTitle>OFFGRID | Outside the Ordinary.</PageTitle>

@* HERO (dark) *@
<section class="border-b border-white/10 bg-ink text-white">
    <div class="mx-auto grid max-w-[1600px] lg:grid-cols-12">
        <div class="flex flex-col justify-between px-6 pb-14 pt-16 lg:col-span-7 lg:min-h-[88vh] lg:px-12 lg:pb-16 lg:pt-24">
            <div class="flex items-center justify-between border-b border-white/10 pb-4">
                <span class="label text-white/50">Drop 04 // Fall 2026</span>
                <span class="label text-white/50">14.5995° N, 120.9842° E</span>
            </div>

            <div class="my-auto py-12">
                <h1 class="text-[clamp(3.5rem,10.5vw,9rem)] font-black uppercase leading-[0.85] tracking-tighter">
                    <span class="block animate-rise">Outside</span>
                    <span class="block animate-rise delay-1">the</span>
                    <span class="block animate-rise delay-2">ordinary.</span>
                </h1>
                <p class="animate-rise mt-8 max-w-md text-sm uppercase tracking-widest text-white/70 delay-3 sm:text-base">
                    Heavyweight silhouettes. Zero trend-chasing. Uncompromising everyday streetwear.
                </p>
                <div class="animate-rise mt-10 flex flex-wrap gap-4 delay-3">
                    <a href="/shop" class="btn btn-light">Shop the collection</a>
                    <button type="button" class="btn btn-outline-light" @onclick='() => JS.InvokeVoidAsync("offgrid.scrollToId", "story")'>Discover OFFGRID</button>
                </div>
            </div>

            <div class="grid grid-cols-3 border-t border-white/10 pt-4 text-[10px] uppercase tracking-widest text-white/40">
                <span>01 // Limited Stock</span>
                <span>02 // Free Shipping ₱2.5k+</span>
                <span class="text-right">03 // Manila Built</span>
            </div>
        </div>

        <div class="hero-media relative min-h-[420px] border-t border-white/10 bg-concrete lg:col-span-5 lg:border-l lg:border-t-0">
            @if (HeroImage is not null)
            {
                <img src="@HeroImage" alt="OFFGRID campaign hero" class="absolute inset-0 h-full w-full object-cover grayscale contrast-125" />
                <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent lg:hidden"></div>
            }
            else
            {
                <div class="absolute inset-0 flex items-end p-8" aria-hidden="true">
                    <span class="select-none text-[clamp(8rem,20vw,16rem)] font-black leading-none tracking-tighter text-ink/20">OG</span>
                </div>
            }
        </div>
    </div>
</section>

@* STREETWEAR TICKER MARQUEE *@
<div class="overflow-hidden border-b border-ink bg-ink py-2.5 text-white" aria-hidden="true">
    <div class="animate-ticker text-xs font-bold uppercase tracking-[0.25em]">
        <span class="mx-6">Drop 04 Live</span> •
        <span class="mx-6">Free Nationwide Shipping Over ₱2,500</span> •
        <span class="mx-6">Heavyweight Fleece & Graphic Tees</span> •
        <span class="mx-6">Outside The Ordinary</span> •
        <span class="mx-6">Drop 04 Live</span> •
        <span class="mx-6">Free Nationwide Shipping Over ₱2,500</span> •
        <span class="mx-6">Heavyweight Fleece & Graphic Tees</span> •
        <span class="mx-6">Outside The Ordinary</span> •
    </div>
</div>

@* FEATURED (cream) *@
<section class="bg-cream">
    <div class="mx-auto max-w-[1400px] px-6 py-20 lg:px-12 lg:py-28">
        <Reveal>
            <div class="flex items-end justify-between border-b border-ink/15 pb-5">
                <div>
                    <p class="label text-ink/50">Archive</p>
                    <h2 class="mt-2 text-3xl font-black uppercase tracking-tight sm:text-5xl">Featured pieces</h2>
                </div>
                <a href="/shop" class="nav-link">View all (@Catalog.All.Count)</a>
            </div>
            <div class="mt-12 grid grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-6 lg:grid-cols-4">
                @foreach (var p in Catalog.Featured())
                {
                    <ProductCard Product="p" @key="p.Id" />
                }
            </div>
        </Reveal>
    </div>
</section>

@* CATEGORIES (white) *@
<section class="border-y border-ink/10 bg-white">
    <div class="mx-auto max-w-[1400px] px-6 py-20 lg:px-12 lg:py-28">
        <Reveal>
            <div class="flex items-end justify-between border-b border-ink/15 pb-5">
                <div>
                    <p class="label text-ink/50">Directory</p>
                    <h2 class="mt-2 text-3xl font-black uppercase tracking-tight sm:text-5xl">Shop by category</h2>
                </div>
            </div>
            <div class="mt-12 grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-6 lg:grid-cols-4">
                @foreach (var c in ProductCatalog.Categories)
                {
                    var rep = Catalog.All.FirstOrDefault(p => p.Category == c) ?? Catalog.All.First();
                    var count = Catalog.All.Count(p => p.Category == c);
                    <a href="@(ProductCatalog.CategoryUrl(c))" class="group block">
                        <div class="relative overflow-hidden border border-ink/10 bg-fog">
                            <ProductImage Product="rep" />
                            <span class="absolute bottom-3 left-3 bg-ink px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-white">
                                @count @(count == 1 ? "Item" : "Items")
                            </span>
                        </div>
                        <div class="mt-3 flex items-center justify-between border-b border-ink/20 pb-2 transition-colors group-hover:border-ink">
                            <span class="text-sm font-bold uppercase tracking-wider">@c</span>
                            <span class="text-xs transition-transform duration-300 group-hover:translate-x-1">→</span>
                        </div>
                    </a>
                }
            </div>
        </Reveal>
    </div>
</section>

@* EDITORIAL STORY (dark) *@
<section id="story" class="bg-ink text-white">
    <div class="mx-auto grid max-w-[1400px] items-center gap-12 px-6 py-24 lg:grid-cols-12 lg:px-12 lg:py-36">
        <Reveal Class="lg:col-span-7">
            <p class="label text-white/50">The Manifesto</p>
            <h2 class="mt-6 text-3xl font-black uppercase leading-[1] tracking-tight sm:text-5xl lg:text-6xl">
                Built for those who move differently.
            </h2>
            <p class="mt-8 max-w-lg text-base leading-relaxed text-white/70">
                OFFGRID was founded to oppose disposable micro-trends. Every garment uses dense heavyweight cotton, boxy dropped-shoulder cuts, and understated industrial detailing. Built to last outside the noise.
            </p>
            <div class="mt-10 flex items-center gap-6">
                <a href="/shop?sort=new" class="btn btn-light">Explore Drop 04</a>
                <span class="label text-white/40">100% Cotton // Preshrunk</span>
            </div>
        </Reveal>
        <Reveal Class="lg:col-span-5" Delay="150">
            <div class="relative flex aspect-[4/5] flex-col justify-between border border-white/20 bg-concrete p-8" aria-hidden="true">
                <div class="flex justify-between font-mono text-xs uppercase tracking-widest text-ink/40">
                    <span>OG-MANIFESTO</span>
                    <span>2026</span>
                </div>
                <div class="select-none text-6xl font-black uppercase leading-[0.88] tracking-tighter text-ink/25 sm:text-7xl">
                    NO<br />SIGNAL<br />FOUND
                </div>
                <div class="font-mono text-xs uppercase tracking-widest text-ink/40">
                    STATUS: DISCONNECTED
                </div>
            </div>
        </Reveal>
    </div>
</section>

@* NEW ARRIVALS (cream) *@
<section class="bg-cream">
    <div class="mx-auto max-w-[1400px] px-6 py-20 lg:px-12 lg:py-28">
        <Reveal>
            <div class="flex items-end justify-between border-b border-ink/15 pb-5">
                <div>
                    <p class="label text-ink/50">Latest Drop</p>
                    <h2 class="mt-2 text-3xl font-black uppercase tracking-tight sm:text-5xl">New arrivals</h2>
                </div>
                <a href="/shop?sort=new" class="nav-link">Shop all new</a>
            </div>
            <div class="mt-12 grid grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-6 lg:grid-cols-4">
                @foreach (var p in Catalog.NewArrivals(4))
                {
                    <ProductCard Product="p" @key="p.Id" />
                }
            </div>
        </Reveal>
    </div>
</section>

@* NEWSLETTER (fog) *@
<section class="border-t border-ink/10 bg-fog">
    <div class="mx-auto max-w-[1400px] px-6 py-20 lg:px-12 lg:py-28">
        <Reveal Class="mx-auto max-w-xl text-center">
            <p class="label text-ink/50">Drop Access</p>
            <h2 class="mt-2 text-3xl font-black uppercase tracking-tight sm:text-5xl">First to know.</h2>
            <p class="mt-4 text-sm text-ink/70">Receive private drop links and restock alerts. No spam, ever.</p>

            @if (subscribed)
            {
                <div class="mt-8 border border-ink bg-white p-6">
                    <p role="status" class="text-sm font-bold uppercase tracking-wider text-ink">You are on the list.</p>
                    <p class="mt-1 text-xs text-ink/60">Demo verified. Check your inbox on launch morning.</p>
                </div>
            }
            else
            {
                <EditForm Model="newsletter" OnValidSubmit="Subscribe" class="mt-8 text-left" novalidate>
                    <DataAnnotationsValidator />
                    <label for="nl-email" class="sr-only">Email address</label>
                    <div class="flex flex-col gap-2 sm:flex-row">
                        <InputText id="nl-email" @bind-Value="newsletter.Email" class="field bg-white" placeholder="ENTER YOUR EMAIL" autocomplete="email" />
                        <button type="submit" class="btn btn-dark shrink-0">Subscribe</button>
                    </div>
                    <ValidationMessage For="() => newsletter.Email" class="mt-2 text-xs font-semibold text-red-700" />
                </EditForm>
            }
        </Reveal>
    </div>
</section>

@code {
    const string? HeroImage = "/images/hero/hero.jpg";

    readonly NewsletterModel newsletter = new();
    bool subscribed;

    void Subscribe() => subscribed = true;

    class NewsletterModel
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [RegularExpression(@"^[^@\s]+@[^@\s]+\.[^@\s]+$", ErrorMessage = "Enter a valid email address.")]
        public string? Email { get; set; }
    }
}