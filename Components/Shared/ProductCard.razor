<div class="group relative flex flex-col bg-white">
    @* Media Container *@
    <div class="relative aspect-[3/4] w-full overflow-hidden bg-fog">
        <a href="/product/@Product.Id" class="block h-full w-full" tabindex="-1">
            @if (!string.IsNullOrEmpty(CurrentImage))
            {
                <img src="@CurrentImage"
                     alt="@Product.Name"
                     loading="lazy"
                     class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105" />
            }
            else
            {
                <div class="flex h-full w-full flex-col items-center justify-center p-4 text-center" style="background-color:@ActiveHex">
                    <span class="text-xs font-mono uppercase tracking-widest text-ink/40">OFFGRID</span>
                    <span class="mt-2 text-sm font-bold uppercase tracking-wider text-ink/70">@Product.Name</span>
                </div>
            }
        </a>

        @* Top-left Tag Badge *@
        @if (!string.IsNullOrWhiteSpace(Product.Badge))
        {
            <div class="absolute left-2.5 top-2.5 z-10 bg-ink px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">
                @Product.Badge
            </div>
        }

        @* Bottom-left UNIQLO Bestseller Badge *@
        @if (Product.Stock > 0 && (Product.Price >= 899 || Product.Badge == "Bestseller"))
        {
            <div class="absolute bottom-2.5 left-2.5 z-10 bg-white/95 px-2 py-0.5 text-[10px] font-semibold tracking-wide text-ink shadow-sm">
                Bestseller
            </div>
        }
        else if (Product.Stock == 0)
        {
            <div class="absolute bottom-2.5 left-2.5 z-10 bg-ink px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">
                Sold Out
            </div>
        }

        @* Hover Carousel Arrows (visible when multi-image exists) *@
        @if (Product.Images.Length > 1)
        {
            <button type="button"
                    class="absolute left-1.5 top-1/2 -translate-y-1/2 rounded-full bg-white/80 p-1.5 text-ink opacity-0 transition-opacity hover:bg-white group-hover:opacity-100"
                    aria-label="Previous view"
                    @onclick:stopPropagation="true"
                    @onclick="PreviousImage">
                <svg class="h-3.5 w-3.5 stroke-current stroke-2 fill-none" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6" /></svg>
            </button>
            <button type="button"
                    class="absolute right-1.5 top-1/2 -translate-y-1/2 rounded-full bg-white/80 p-1.5 text-ink opacity-0 transition-opacity hover:bg-white group-hover:opacity-100"
                    aria-label="Next view"
                    @onclick:stopPropagation="true"
                    @onclick="NextImage">
                <svg class="h-3.5 w-3.5 stroke-current stroke-2 fill-none" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6" /></svg>
            </button>
        }
    </div>

    @* Meta Details Block *@
    <div class="flex flex-1 flex-col pt-3">
        @* Swatches & Wishlist Row *@
        <div class="flex items-center justify-between pb-2">
            <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Available Colors">
                @foreach (var c in Product.Colors)
                {
                    var isSelected = string.Equals(ActiveColor, c.Name, StringComparison.OrdinalIgnoreCase);
                    <button type="button"
                            class="h-4 w-4 rounded-full border transition-transform @(isSelected ? "border-ink ring-1 ring-ink ring-offset-1 scale-110" : "border-ink/20 hover:scale-110")"
                            style="background-color: @c.Hex"
                            title="@c.Name"
                            aria-label="@c.Name"
                            @onclick:stopPropagation="true"
                            @onclick="() => SelectColor(c.Name)">
                    </button>
                }
            </div>

            @* Wishlist Heart Button *@
            <button type="button"
                    class="p-1 text-ink/70 transition-colors hover:text-red-600"
                    aria-label="Add to wishlist"
                    @onclick:stopPropagation="true"
                    @onclick="() => isFavorite = !isFavorite">
                @if (isFavorite)
                {
                    <svg class="h-4 w-4 fill-red-600 text-red-600" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                }
                else
                {
                    <svg class="h-4 w-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                }
            </button>
        </div>

        @* Gender & Size Range *@
        <p class="text-[11px] font-normal text-ink/60">
            Unisex, @SizeRange
        </p>

        @* Product Title *@
        <h3 class="mt-1 line-clamp-2 text-xs font-semibold leading-snug text-ink">
            <a href="/product/@Product.Id" class="hover:underline">
                @Product.Name
            </a>
        </h3>

        @* Price Row *@
        <div class="mt-1.5 flex items-baseline gap-2">
            @if (IsOnSale)
            {
                <span class="text-sm font-bold text-red-600">PHP @SalePrice.ToString("N2")</span>
                <span class="text-xs text-ink/40 line-through">PHP @Product.Price.ToString("N2")</span>
            }
            else
            {
                <span class="text-sm font-bold text-ink">PHP @Product.Price.ToString("N2")</span>
            }
        </div>

        @* Promotional / Fabric Subtitle *@
        @if (IsOnSale)
        {
            <p class="mt-0.5 text-[10px] font-semibold text-red-600">Sale, Limited Offer</p>
        }
        else
        {
            <p class="mt-0.5 text-[10px] text-ink/50">Unisex, 100% Heavyweight Cotton</p>
        }

        @* UNIQLO Star Rating *@
        <div class="mt-2 flex items-center gap-1 text-[11px] font-medium text-ink/80">
            <svg class="h-3 w-3 fill-amber-400 text-amber-400" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            <span class="font-bold">@Rating</span>
            <span class="text-ink/40">(@ReviewCount)</span>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Product Product { get; set; } = default!;
    [Parameter] public string? ColorName { get; set; }

    string? selectedColor;
    int imageIndex = 0;
    bool isFavorite;

    string? ActiveColor => selectedColor ?? ColorName ?? Product.Colors.FirstOrDefault()?.Name;

    string ActiveHex => Product.Colors.FirstOrDefault(c =>
        string.Equals(c.Name, ActiveColor, StringComparison.OrdinalIgnoreCase))?.Hex ?? "#E8E6E1";

    string SizeRange => Product.Sizes.Length > 1
        ? $"{Product.Sizes.First()}–{Product.Sizes.Last()}"
        : (Product.Sizes.FirstOrDefault() ?? "All");

    bool IsOnSale => Product.Price >= 1200;
    decimal SalePrice => Product.Price - 300m;

    string Rating => (4.5 + ((Product.Id.GetHashCode() & 0x7FFFFFFF) % 5) * 0.1).ToString("0.0");
    int ReviewCount => 50 + ((Product.Id.GetHashCode() & 0x7FFFFFFF) % 450);

    string? CurrentImage
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(ActiveColor))
            {
                var match = Product.ColorImages.FirstOrDefault(kv =>
                    string.Equals(kv.Key, ActiveColor, StringComparison.OrdinalIgnoreCase));
                if (!string.IsNullOrEmpty(match.Value)) return match.Value;
            }
            if (Product.Images.Length > 0)
            {
                var idx = Math.Clamp(imageIndex, 0, Product.Images.Length - 1);
                return Product.Images[idx];
            }
            return null;
        }
    }

    void SelectColor(string name)
    {
        selectedColor = name;
        imageIndex = 0;
    }

    void NextImage()
    {
        if (Product.Images.Length > 1)
        {
            imageIndex = (imageIndex + 1) % Product.Images.Length;
        }
    }

    void PreviousImage()
    {
        if (Product.Images.Length > 1)
        {
            imageIndex = (imageIndex - 1 + Product.Images.Length) % Product.Images.Length;
        }
    }
}