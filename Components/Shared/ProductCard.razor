<a href="/product/@Product.Id" class="group block">
    <div class="relative">
        <ProductImage Product="Product" ColorName="@ColorName" HoverSwap="true" />
        @if (Product.Stock == 0)
        {
            <span class="label absolute left-3 top-3 bg-white px-2.5 py-1 text-ink">Sold out</span>
        }
        else if (Product.Badge is not null)
        {
            <span class="label absolute left-3 top-3 bg-ink px-2.5 py-1 text-white">@Product.Badge</span>
        }
    </div>
    <div class="mt-4 flex items-start justify-between gap-4">
        <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide">@Product.Name</h3>
            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-ink/60">
                @Product.Category · @Product.Colors.Length @(Product.Colors.Length == 1 ? "color" : "colors")
            </p>
        </div>
        <p class="text-sm font-medium">@Product.PriceText</p>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public Product Product { get; set; } = default!;
    [Parameter] public string? ColorName { get; set; }
}