<div class="relative aspect-[4/5] w-full shrink-0 overflow-hidden bg-fog @Class">
    <div class="absolute inset-0 transition-transform duration-700 ease-out group-hover:scale-105">
        @if (!string.IsNullOrEmpty(ResolvedSrc))
        {
            <img src="@ResolvedSrc"
                 alt="@Alt"
                 loading="lazy"
                 class="h-full w-full object-cover transition-opacity duration-300" />
        }
        else
        {
            @* High-end industrial fallback card with registration marks *@
            <div class="relative flex h-full w-full flex-col justify-between p-4" style="background-color:@Hex" role="img" aria-label="@Alt">
                <div class="flex items-start justify-between text-[9px] font-mono tracking-widest @Tone">
                    <span>+</span>
                    <span>OFFGRID // SPEC</span>
                    <span>+</span>
                </div>
                <div class="text-center">
                    <span class="block select-none text-2xl font-black tracking-[0.35em] @Tone">OFFGRID</span>
                    <span class="mt-1 block text-[10px] uppercase tracking-widest @Tone">@Product.Category</span>
                </div>
                <div class="flex items-end justify-between text-[9px] font-mono tracking-widest @Tone">
                    <span>+</span>
                    <span>@Hex</span>
                    <span>+</span>
                </div>
            </div>
        }
    </div>

    @if (HoverSwap && !string.IsNullOrEmpty(ResolvedSrc) && !string.IsNullOrEmpty(SecondSrc))
    {
        <img src="@SecondSrc"
             alt=""
             loading="lazy"
             class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
    }
</div>

@code {
    [Parameter, EditorRequired] public Product Product { get; set; } = default!;
    [Parameter] public string? ColorName { get; set; }
    [Parameter] public bool HoverSwap { get; set; }
    [Parameter] public string? Class { get; set; }

    // Case-insensitive dictionary lookup to guarantee matching "Cream" with "cream" keys
    string? ResolvedSrc
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(ColorName))
            {
                var match = Product.ColorImages.FirstOrDefault(kv =>
                    string.Equals(kv.Key, ColorName, StringComparison.OrdinalIgnoreCase));
                if (!string.IsNullOrEmpty(match.Value)) return match.Value;
            }
            return Product.Images.FirstOrDefault();
        }
    }

    string? SecondSrc => Product.Images.Length > 1 ? Product.Images[1] : null;

    ProductColor? Color => (!string.IsNullOrWhiteSpace(ColorName)
        ? Product.Colors.FirstOrDefault(c => string.Equals(c.Name, ColorName, StringComparison.OrdinalIgnoreCase))
        : null) ?? Product.Colors.FirstOrDefault();

    string Hex => Color?.Hex ?? "#E8E6E1";
    string Alt => $"{Product.Name}, {Color?.Name ?? "default"}";
    string Tone => IsLight(Hex) ? "text-ink/40" : "text-white/40";

    static bool IsLight(string hex)
    {
        if (string.IsNullOrWhiteSpace(hex) || hex.Length < 7) return true;
        var r = Convert.ToInt32(hex[1..3], 16);
        var g = Convert.ToInt32(hex[3..5], 16);
        var b = Convert.ToInt32(hex[5..7], 16);
        return (0.299 * r + 0.587 * g + 0.114 * b) > 150;
    }
}