<div class="relative aspect-[4/5] shrink-0 overflow-hidden border border-ink/10 bg-fog @Class">
    <div class="absolute inset-0 transition-transform duration-700 ease-out group-hover:scale-105">
        @if (Src is not null)
        {
            <img src="@Src" alt="@Alt" loading="lazy" class="h-full w-full object-cover" />
        }
        else
        {
            <div class="flex h-full w-full items-end p-4" style="background-color:@Hex" role="img" aria-label="@Alt">
                <span class="select-none text-xl font-black tracking-[0.3em] @Tone" aria-hidden="true">OFFGRID</span>
            </div>
        }
    </div>
    @if (HoverSwap && Src is not null && SecondSrc is not null)
    {
        <img src="@SecondSrc" alt="" loading="lazy"
             class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
    }
</div>

@code {
    [Parameter, EditorRequired] public Product Product { get; set; } = default!;
    [Parameter] public string? ColorName { get; set; }
    [Parameter] public bool HoverSwap { get; set; }
    [Parameter] public string? Class { get; set; }

    string? Src => ColorName is not null && Product.ColorImages.TryGetValue(ColorName, out var p)
        ? p : Product.Images.FirstOrDefault();
    string? SecondSrc => Product.Images.Length > 1 ? Product.Images[1] : null;
    ProductColor? Color => Product.Colors.FirstOrDefault(c => c.Name == ColorName) ?? Product.Colors.FirstOrDefault();
    string Hex => Color?.Hex ?? "#E8E6E1";
    string Alt => $"{Product.Name}, {Color?.Name ?? "default"}";
    string Tone => IsLight(Hex) ? "text-ink/30" : "text-white/30";

    static bool IsLight(string hex)
    {
        var r = Convert.ToInt32(hex[1..3], 16);
        var g = Convert.ToInt32(hex[3..5], 16);
        var b = Convert.ToInt32(hex[5..7], 16);
        return 0.299 * r + 0.587 * g + 0.114 * b > 150;
    }
}